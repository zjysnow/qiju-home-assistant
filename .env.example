# Keep the server on this computer by default.
HOST=127.0.0.1
PORT=3000

# First-run administrator account. The password is used only to initialize the
# account store; account passwords are later managed in the web interface.
# If left blank on localhost, a random password is printed once at startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Backward-compatible fallback for the first-run administrator password.
# Required on the first startup when HOST is not localhost.
APP_PASSWORD=

# Optional local AI via Ollama. Leave OLLAMA_URL blank to use the built-in
# command parser. Ollama must be running on this computer.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Optional Home Assistant connection. Create a long-lived access token in
# your HA profile. Unmapped devices remain simulated.
HA_URL=
HA_TOKEN=
HA_ENTITIES_JSON={}

# Example mapping (replace entity IDs with your own):
# HA_ENTITIES_JSON={"living-light":"light.living_room","living-ac":"climate.living_room","living-curtain":"cover.living_room_curtain"}
